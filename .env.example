# Resend API key. Server-side only. Create one at https://resend.com/api-keys
# Leave empty in local development to exercise the contact form in mock mode.
RESEND_API_KEY=

# Inbox that receives contact-form messages. One address.
CONTACT_TO_EMAIL=

# Verified sender. Use a display name and a mailbox on a domain you have
# verified in Resend, for example:
# James Dolan <website@jamesdolan.info>
# The sandbox address onboarding@resend.dev can only deliver to the email
# address on your Resend account.
CONTACT_FROM_EMAIL=

# Set to "mock" to accept valid submissions without calling Resend,
# even if RESEND_API_KEY is present. Useful for preview deployments.
# CONTACT_DELIVERY=mock

# Optional Cloudflare Turnstile. Both keys are required for the widget.
# The site key is public. The secret must stay server-side.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
